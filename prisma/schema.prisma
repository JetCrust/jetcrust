// Jet Crust booking data model.
// Property CONTENT lives in the data/*.json files (single source of truth).
// This database holds only accounts, bookings, availability and consent records.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  GUEST
  ADMIN     // Super Admin — full access
  MANAGER   // Property / Location Manager — scoped to assigned properties
}

enum BookingStatus {
  REQUESTED   // card authorized (held), awaiting host approval
  APPROVED    // host approved, card captured, dates blocked
  DECLINED    // host declined, hold released
  CANCELLED
  EXPIRED     // authorization lapsed before approval
}

enum BlockSource {
  MANUAL
  ICAL
  BOOKING
}

enum PostStatus {
  DRAFT
  PUBLISHED
}

// Journal / blog. Fully managed from the admin dashboard.
model Post {
  id             String     @id @default(cuid())
  slug           String     @unique
  title          String
  excerpt        String
  body           String     // markdown
  coverImage     String?    // URL or /assets path (use our own or free-to-use images)
  tags           String     @default("[]") // JSON array
  faq            String     @default("[]") // JSON array of { q, a }
  seoTitle       String?
  seoDescription String?
  status         PostStatus @default(DRAFT)
  source         String     @default("manual") // "manual" | "ai"
  publishedAt    DateTime?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  @@index([status, publishedAt])
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String?
  passwordHash String
  role         Role     @default(GUEST)
  managedSlugs String[] @default([]) // property slugs a MANAGER is assigned to
  lastSeenAt   DateTime? // last activity, to skip notification emails when online
  createdAt    DateTime @default(now())

  // Profile & preferences
  title           String? // Mr / Mrs / Ms / Mx
  phone           String?
  preferences     String? // dietary, allergies, occasions, requests
  marketingOptIn  Boolean @default(false)

  // Saved billing address (prefills checkout)
  billingName     String?
  billingLine1    String?
  billingLine2    String?
  billingCity     String?
  billingPostcode String?
  billingCountry  String?

  // Account-level Stripe customer, for saved cards
  stripeCustomerId String?

  bookings     Booking[]
  acceptances  ContractAcceptance[]
  messages     Message[]
}

// Properties live in the database so they can be added and managed from the admin.
// `data` holds the full property object (same shape the app already uses); the
// scalar columns are what we filter and sort on.
model Property {
  id        String   @id @default(cuid())
  slug      String   @unique
  status    String   @default("live") // live | draft
  order     Int      @default(99)
  name      String
  location  String   @default("")
  data      String   // full property JSON
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, order])
}

model Booking {
  id                    String        @id @default(cuid())
  propertySlug          String
  user                  User          @relation(fields: [userId], references: [id])
  userId                String
  checkIn               DateTime
  checkOut              DateTime
  guests                Int           @default(2)
  addons                String        @default("[]") // JSON array of add-on keys
  status                BookingStatus @default(REQUESTED)
  amountCents           Int           // full stay total (stay + add-ons)
  currency              String        @default("eur")
  note                  String?       // guest's note at booking
  adminNotes            String?       // internal host notes, guest never sees these
  guestMessages         String        @default("[]") // guest's change requests/messages: [{text, at}]
  breakdown             String?       // JSON snapshot of the quote as priced at booking
  createdAt             DateTime      @default(now())
  approvedAt            DateTime?

  // Payment: deposit now, balance later (split), via Stripe
  depositCents          Int?          // amount held/charged first (= amountCents when no split)
  balanceCents          Int           @default(0)
  balanceDueAt          DateTime?
  balancePaidAt         DateTime?
  stripeCustomerId      String?
  stripePaymentIntentId String?       // the deposit/hold intent
  stripePaymentMethodId String?       // saved card, for the balance charge

  // Security / damage deposit (separate from the stay payment). Held near check-in,
  // released on a clean checkout, or captured (part/all) for damage or extras.
  securityCents         Int       @default(0)      // the deposit amount for this stay
  securityHoldId        String?                     // Stripe PaymentIntent for the hold
  securityStatus        String    @default("none")  // none | held | released | captured | expired
  securityCapturedCents Int       @default(0)
  securityHeldAt        DateTime?
  securityResolvedAt    DateTime?

  // Extras ledger (Stage 3): [{ id, desc, amountCents, at, settled, settledVia }]
  extras                String    @default("[]")
  refundedCents         Int       @default(0)   // total refunded on the stay payment

  // Guest depth: pre-arrival preferences for this stay + post-stay review
  stayPreferences       String?                 // arrival time, occasion, requests for this stay
  reviewRating          Int?                     // 1..5, set after checkout
  reviewText            String?
  reviewedAt            DateTime?

  acceptance            ContractAcceptance?

  @@index([propertySlug, status])
  @@index([userId])
}

model ContractAcceptance {
  id              String   @id @default(cuid())
  user            User     @relation(fields: [userId], references: [id])
  userId          String
  booking         Booking  @relation(fields: [bookingId], references: [id])
  bookingId       String   @unique
  contractVersion String
  ipAddress       String
  userAgent       String
  acceptedAt      DateTime @default(now())
}

// External calendars (Airbnb, VRBO, concierge) import here via iCal; our
// confirmed bookings also create a block. This is the availability source of truth.
model AvailabilityBlock {
  id           String      @id @default(cuid())
  propertySlug String
  start        DateTime
  end          DateTime
  source       BlockSource @default(MANUAL)
  note         String?
  meta         String?     // JSON for imported feeds: { link, phoneLast4, code, summary }
  createdAt    DateTime    @default(now())

  @@index([propertySlug, start, end])
}

enum StayFormKind {
  CHECKIN
  CHECKOUT
}

enum TaskStatus {
  OPEN
  IN_PROGRESS
  DONE
}

enum TaskCategory {
  CLEANING
  MAINTENANCE
  INSPECTION
  RESTOCK
  OTHER
}

// Operations task tied to a property (and optionally a booking), assignable to
// a team member. Turnovers, maintenance, inspections, restocking.
model Task {
  id           String       @id @default(cuid())
  propertySlug String
  bookingId    String?
  title        String
  category     TaskCategory @default(CLEANING)
  status       TaskStatus   @default(OPEN)
  dueAt        DateTime?
  assignedToId String?      // a staff (ADMIN/MANAGER) user id
  notes        String?
  createdAt    DateTime     @default(now())
  completedAt  DateTime?

  @@index([propertySlug, status])
}

// Two-way message thread between a guest and the host. Anchored to a booking for
// context/scoping, and to the guest (userId) so their conversation is continuous
// across bookings (client dashboard + admin guest profile).
model Message {
  id          String   @id @default(cuid())
  bookingId   String
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  sender      String   // "GUEST" | "ADMIN"
  body        String
  createdAt   DateTime @default(now())
  readByAdmin Boolean  @default(false)
  readByGuest Boolean  @default(false)

  @@index([bookingId, createdAt])
  @@index([userId, createdAt])
}

// Digital check-in / check-out report (tablet-first). Condition photos, extras
// consumed, additional charges, deposit outcome and the guest's finger signature,
// all saved against the booking. Photos live in Vercel Blob (compressed on device).
model StayReport {
  id              String       @id @default(cuid())
  bookingId       String
  kind            StayFormKind @default(CHECKOUT)
  photos          String       @default("[]") // [{ url, at }]
  items           String       @default("[]") // extras consumed: [{ desc, amountCents }]
  additionalCents Int          @default(0)
  depositStatus   String       @default("pending") // pending | refund | partial | claim
  depositNote     String?
  guestName       String?
  staffName       String?
  notes           String?
  signature       String?      // finger-drawn signature, PNG data URL
  completedAt     DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@index([bookingId, kind])
}

enum ExpenseCategory {
  CLEANING
  MAINTENANCE
  SUPPLIES
  COMMISSION   // OTA / partner commission — shown as its own P&L line
  UTILITIES
  OTHER
}

// Costs for the P&L (Stage 3). Entered by admin. `commission` is a category so
// OTA/partner fees appear on their own line. Optionally tied to a property and/or booking.
model Expense {
  id           String          @id @default(cuid())
  propertySlug String?         // null = portfolio-wide / unattributed
  bookingId    String?         // optional link to the booking that incurred it
  category     ExpenseCategory @default(OTHER)
  description  String
  amountCents  Int
  date         DateTime        // when the cost was incurred (drives date-range filtering)
  createdAt    DateTime        @default(now())

  @@index([propertySlug, date])
  @@index([date])
}
